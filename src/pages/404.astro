---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import Footer from "../components/Footer";
---

<Layout title="404: Ez da aurkitu | Borda Ardoak">
    <Navbar client:load pathname="/404" />
    <main class="min-h-screen flex items-center justify-center bg-[#FDFCFB] pt-32 pb-20 overflow-hidden relative">
        <!-- Decoración de fondo -->
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-[#722F37]/2 rounded-full blur-[120px] -z-10"></div>
        
        <div class="max-w-6xl mx-auto px-6 relative">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-24 items-center">
                <!-- Lado Izquierdo: Ilustración -->
                <div class="relative flex justify-center lg:justify-end">
                    <div class="relative group">
                        <div class="absolute -inset-12 bg-[#722F37]/10 rounded-full blur-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
                        <svg viewBox="0 0 100 120" class="w-64 h-64 md:w-80 md:h-80 text-[#722F37] relative drop-shadow-[0_25px_25px_rgba(0,0,0,0.1)]" xmlns="http://www.w3.org/2000/svg">
                            <!-- Copa de vino -->
                            <path d="M30 20 L70 20 L65 55 C63 70 37 70 35 55 Z" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" />
                            <!-- Tallo y base -->
                            <line x1="50" y1="70" x2="50" y2="100" stroke="currentColor" stroke-width="2.5" />
                            <path d="M35 100 L65 100" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
                            
                            <!-- Vino vaciándose -->
                            <path d="M38 45 Q50 48 62 45" fill="none" stroke="currentColor" stroke-width="1" class="opacity-30" />
                            
                            <!-- Cara triste en la copa -->
                            <circle cx="43" cy="40" r="1.5" fill="currentColor" />
                            <circle cx="57" cy="40" r="1.5" fill="currentColor" />
                            <path d="M44 52 Q50 48 56 52" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                            
                            <!-- Lágrima cayendo -->
                            <circle cx="50" cy="75" r="3" fill="currentColor">
                                <animate attributeName="cy" values="75;115" dur="3s" repeatCount="indefinite" />
                                <animate attributeName="opacity" values="1;0" dur="3s" repeatCount="indefinite" />
                            </circle>
                        </svg>
                    </div>
                </div>

                <!-- Lado Derecho: Contenido -->
                <div class="text-center lg:text-left space-y-8">
                    <div class="relative inline-block lg:block">
                        <span class="text-[8rem] md:text-[10rem] font-bold text-[#722F37]/5 leading-none select-none">404</span>
                        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-[#1A1A1A] tracking-tight -mt-16 md:-mt-20 relative z-10"> 
                            Hustu egin da <br/>
                            <span class="font-light italic font-serif text-[#722F37]">koparia</span>
                        </h1>
                    </div>
                    
                    <p class="text-lg md:text-xl text-gray-500 max-w-lg mx-auto lg:mx-0 leading-relaxed font-medium">
                        Barkatu, badirudi bilatzen ari zaren orria ez dagoela eskuragarri une honetan.
                    </p>

                    <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-6 pt-4">
                        <a 
                            href="/" 
                            class="group inline-flex items-center justify-center px-10 py-5 bg-[#722F37] text-white rounded-full font-bold hover:bg-[#5a252c] transition-all hover:scale-105 active:scale-95 gap-3 shadow-xl shadow-[#722F37]/20"
                        >
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                            Hasierara itzuli
                        </a>
                        <a 
                            href="/kontaktua" 
                            class="text-[#1A1A1A] font-bold hover:text-[#722F37] transition-all flex items-center gap-2 group p-2"
                        >
                            Laguntza behar duzu?
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </main>
    </main>
    <Footer client:load />
</Layout>
