---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import Footer from "../components/Footer";
---

<Layout title="Zerbitzuak">
    <Navbar client:load pathname={Astro.url.pathname} />
    <main class="pt-32 pb-20 bg-[#FDFCFB]">
        <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <header class="mb-14 text-center">
                <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#722F37]/80">Borda Ardoak</p>
                <h1 class="text-4xl md:text-5xl font-bold text-[#1A1A1A] mt-3 tracking-tight">
                    Zure ardo hornitzaile <span class="text-[#722F37] italic font-light">integrala</span>
                </h1>
                <p class="mt-4 text-lg text-gray-600 max-w-3xl mx-auto">
                    Kalitatea eta zerbitzua, botila bakoitzean. Dendako ardo hautaketatik ostalaritza banaketara, profesionaltasun osoz.
                </p>
            </header>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
                <a href="/produktuak" class="group relative rounded-[2.5rem] overflow-hidden bg-white border border-gray-100 shadow-xl transition-all duration-500 hover:shadow-2xl hover:-translate-y-1">
                    <div class="aspect-[16/10] overflow-hidden">
                        <img
                            src="https://bordaardoak.eus/wp-content/uploads/2021/03/Borda-zerbitzuak-1-800x534.jpg"
                            alt="Ardo eskaintza, upelak eta mahats sorta"
                            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                            loading="lazy"
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent opacity-80 transition-opacity group-hover:opacity-90"></div>
                    </div>
                    
                    <div class="absolute bottom-0 left-0 w-full p-8 md:p-10 text-white">
                        <div class="flex items-center gap-2 mb-3">
                            <div class="h-[1px] w-8 bg-[#722F37]"></div>
                            <span class="text-xs font-bold uppercase tracking-widest text-[#722F37]">Denda</span>
                        </div>
                        <h2 class="text-3xl font-bold mb-4 tracking-tight">Ardoen hautaketa esklusiboa</h2>
                        <p class="text-white/80 leading-relaxed max-w-lg mb-6 line-clamp-2 md:line-clamp-none">
                            Upategi onenetako erreferentziak eta aurkikuntza bereziak, zuretzat aukeratuak.
                        </p>
                        <div class="flex items-center gap-2 text-sm font-bold group-hover:gap-4 transition-all uppercase tracking-widest">
                            Ikusi gehiago <span class="text-xl">→</span>
                        </div>
                    </div>
                </a>

                <a href="/kontaktua" class="group relative rounded-[2.5rem] overflow-hidden bg-white border border-gray-100 shadow-xl transition-all duration-500 hover:shadow-2xl hover:-translate-y-1">
                    <div class="aspect-[16/10] overflow-hidden">
                        <img
                            src="https://bordaardoak.eus/wp-content/uploads/2021/03/Borda-zerbitzuak-800x534.jpg"
                            alt="Banaketa zerbitzua, kutxak garraiatzen"
                            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                            loading="lazy"
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent opacity-80 transition-opacity group-hover:opacity-90"></div>
                    </div>

                    <div class="absolute bottom-0 left-0 w-full p-8 md:p-10 text-white">
                        <div class="flex items-center gap-2 mb-3">
                            <div class="h-[1px] w-8 bg-[#722F37]"></div>
                            <span class="text-xs font-bold uppercase tracking-widest text-[#722F37]">Banaketa</span>
                        </div>
                        <h2 class="text-3xl font-bold mb-4 tracking-tight">Ostalaritzarako banaketa profesionala</h2>
                        <p class="text-white/80 leading-relaxed max-w-lg mb-6 line-clamp-2 md:line-clamp-none">
                            Zerbitzu azkarra eta fidagarria jatetxe, taberna eta hoteletarako. Zure negozioaren erritmoan.
                        </p>
                        <div class="flex items-center gap-2 text-sm font-bold group-hover:gap-4 transition-all uppercase tracking-widest">
                            Jarri gurekin harremanetan <span class="text-xl">→</span>
                        </div>
                    </div>
                </a>
            </div>
        </section>
    </main>
    <Footer client:load />
</Layout>
