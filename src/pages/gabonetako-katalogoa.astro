---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import Footer from "../components/Footer";
---

<Layout title="Gabonetako Katalogoa">
    <Navbar client:load pathname={Astro.url.pathname} />
    <main class="bg-[#FDFCFB] min-h-screen">
        <div class="max-w-[1600px] mx-auto px-6 pt-20 pb-16">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
                <!-- Columna de Texto -->
                <div class="lg:col-span-4 lg:sticky lg:top-32 space-y-8">
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#722F37]/70 mb-3">2025-2026</p>
                        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-[#1A1A1A] leading-[1.05]">
                            Gabonetako<br/>Katalogoa
                        </h1>
                    </div>
                    
                    <div class="space-y-6">
                        <p class="text-gray-600 text-lg leading-relaxed">
                            Arakatu gure Gabonetako produktuen aukeraketa berezia: ardoak, likoreak eta gourmet produktuak zure ospakizunetarako.
                        </p>
                        
                        <div class="p-6 bg-white rounded-2xl shadow-sm border border-gray-100">
                            <p class="text-gray-500 text-sm mb-4">
                                Katalogoa hemen ikus dezakezu o deskargatu nahiago baduzu.
                            </p>
                            <a 
                                href="/pdf/Katalogoa2025-2.pdf" 
                                download
                                class="inline-flex items-center justify-center w-full px-6 py-3 bg-[#722F37] text-white rounded-xl font-medium hover:bg-[#5a252c] transition-all hover:scale-[1.02] active:scale-[0.98] gap-2 shadow-md"
                            >
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-download"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
                                Deskargatu PDF
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Columna del PDF -->
                <div class="lg:col-span-8">
                    <div class="w-full h-[85vh] bg-gray-900 rounded-[2.5rem] overflow-hidden shadow-2xl border-4 border-white">
                        <iframe
                            src="/pdf/Katalogoa2025-2.pdf#view=Fit"
                            title="Gabonetako Katalogoa"
                            class="w-full h-full border-none"
                            loading="lazy"
                        ></iframe>
                    </div>
                </div>
            </div>
        </div>
    </main>
    <Footer client:load />
</Layout>
