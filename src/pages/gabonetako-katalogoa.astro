---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import Footer from "../components/Footer";
---

<Layout title="Gabonetako Katalogoa | Borda Ardoak">
    <Navbar client:load pathname={Astro.url.pathname} />
    <main class="bg-[#FDFCFB] min-h-screen">
        <div class="max-w-[1400px] mx-auto px-6 pt-32 pb-24">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
                <!-- Columna de Texto -->
                <div class="lg:col-span-5 space-y-10">
                    <header class="space-y-6">
                        <div class="inline-flex items-center gap-3 px-4 py-2 bg-[#722F37]/5 rounded-full border border-[#722F37]/10">
                            <span class="w-2 h-2 rounded-full bg-[#722F37] animate-pulse"></span>
                            <span class="text-xs font-bold uppercase tracking-[0.2em] text-[#722F37]">2025 — 2026 Edizioa</span>
                        </div>
                        <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold text-[#1A1A1A] leading-[1.05] tracking-tight">
                            Gabonetako <br/>
                            <span class="text-[#722F37] italic font-light font-serif">Katalogoa</span>
                        </h1>
                        <p class="text-gray-600 text-xl leading-relaxed max-w-xl">
                            Aurkitu oparirik berezienak. Ardo hautatuak, xanpainak eta momentu ahaztezinetarako gourmet produktuak.
                        </p>
                    </header>
                    
                    <div class="flex flex-col sm:flex-row gap-4">
                        <a 
                            href="/pdf/Katalogoa2025-2.pdf" 
                            target="_blank"
                            class="inline-flex items-center justify-center px-10 py-5 bg-[#722F37] text-white rounded-full font-bold hover:bg-[#5a252c] transition-all hover:scale-105 active:scale-95 gap-3 shadow-xl shadow-[#722F37]/20"
                        >
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
                            Deskargatu PDF
                        </a>
                        <a 
                            href="/pdf/Katalogoa2025-2.pdf" 
                            target="_blank"
                            class="inline-flex items-center justify-center px-10 py-5 bg-white text-[#1A1A1A] border-2 border-gray-100 rounded-full font-bold hover:bg-gray-50 transition-all hover:scale-105 active:scale-95 gap-3 shadow-lg"
                        >
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                            Ikusi Online
                        </a>
                    </div>

                    <p class="text-sm text-gray-400 font-medium italic">
                        * PDF formatuan eskuragarri gailu guztietarako.
                    </p>
                </div>

                <!-- Columna del Catálogo (Mockup Revista Física) -->
                <div class="lg:col-span-7 relative group flex justify-center lg:justify-end">
                    <div class="absolute -inset-10 bg-gradient-to-tr from-[#722F37]/5 via-transparent to-[#722F37]/2 rounded-full blur-3xl opacity-50 group-hover:opacity-100 transition-opacity"></div>
                    
                    <div class="relative transform transition-all duration-700 hover:scale-[1.01] hover:-rotate-1">
                        <a href="/pdf/Katalogoa2025-2.pdf" target="_blank" class="block">
                            <!-- Sombra Realista (Efecto Elevación) - Más difusa -->
                            <div class="absolute inset-x-8 -bottom-10 h-2 bg-black/40 blur-2xl opacity-20 group-hover:opacity-40 transition-opacity"></div>
                            
                            <!-- Contenedor del Catálogo (Revista) -->
                            <div class="relative w-full max-w-[520px] aspect-[1/1.41] bg-white overflow-hidden shadow-[0_30px_60px_-15px_rgba(0,0,0,0.3)] ring-1 ring-black/5">
                                <iframe
                                    src="/pdf/Katalogoa2025-2.pdf#page=1&view=FitH&toolbar=0&navpanes=0&scrollbar=0"
                                    title="Gabonetako Katalogoa"
                                    class="w-[106%] h-full border-none pointer-events-none -ml-[3%]"
                                    loading="lazy"
                                ></iframe>
                                
                                <!-- Brillo de papel (Efecto físico realista) -->
                                <div class="absolute inset-0 bg-gradient-to-tr from-white/20 via-transparent to-black/5 pointer-events-none"></div>
                                
                                <!-- Detalle de pliegue lateral (Lomo) mejorado -->
                                <div class="absolute top-0 left-0 bottom-0 w-14 bg-gradient-to-r from-black/25 via-black/5 to-transparent pointer-events-none"></div>
                                <div class="absolute top-0 left-4 bottom-0 w-[1px] bg-white/10 pointer-events-none"></div>
                            </div>
                        </a>

                        <!-- Badge flotante minimalista rediseñado y mejor posicionado -->
                        <div class="absolute -top-4 -right-4 bg-[#722F37] text-white px-6 py-3 rounded-2xl shadow-2xl flex flex-col items-center gap-0.5 transform rotate-6 hover:rotate-0 transition-transform cursor-default z-10 border-4 border-[#FDFCFB]">
                            <span class="text-xs font-bold uppercase tracking-widest leading-none">BERRIA</span>
                            <span class="text-[10px] opacity-70">2025-26</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
    <Footer client:load />
</Layout>
