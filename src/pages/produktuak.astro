---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import Footer from "../components/Footer";
import { getCollection } from "astro:content";

const products = await getCollection("products");

const categories = [
    { label: "Guztiak", value: "all" },
    { label: "Ardoak", value: "wines" },
    { label: "Garagardoak", value: "beers" },
    { label: "Sagardoak", value: "ciders" },
    { label: "Kontserbak", value: "food" },
];
---

<Layout title="Produktuak">
    <Navbar client:load pathname={Astro.url.pathname} />
    <main class="pt-32 pb-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <header class="mb-16">
                <h1
                    class="text-5xl font-bold tracking-tight text-[#1A1A1A] mb-4"
                >
                    Gure Produktuak
                </h1>
                <p class="text-xl text-gray-600 max-w-2xl">
                    Aukeraturiko ardo eta gourmet produktuen katalogo osoa.
                </p>
            </header>

            <!-- Filter Tabs (Simple CSS for now) -->
            <div class="flex flex-wrap gap-4 mb-12">
                {
                    categories.map((cat) => (
                        <button class="px-6 py-2.5 rounded-full border border-gray-200 hover:border-[#722F37] hover:bg-[#722F37] hover:text-white transition-all font-medium text-sm">
                            {cat.label}
                        </button>
                    ))
                }
            </div>

            <div
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8"
            >
                {
                    products.map((product: any) => (
                        <div class="group bg-white rounded-3xl border border-gray-100 p-4 hover:shadow-xl transition-all">
                            <div class="aspect-square rounded-2xl overflow-hidden mb-6 bg-gray-50">
                                <img
                                    src={product.data.image}
                                    alt={product.data.name}
                                    class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                                />
                            </div>
                            <div class="px-2 pb-2">
                                <span class="text-[10px] font-bold uppercase tracking-widest text-[#722F37]/60">
                                    {product.data.category}
                                </span>
                                <h3 class="text-lg font-bold text-[#1A1A1A] mt-1 mb-2">
                                    {product.data.name}
                                </h3>
                                <p class="text-sm text-gray-500 line-clamp-2 mb-4">
                                    {product.data.description}
                                </p>
                                <div class="flex justify-between items-center mt-auto">
                                    <span class="text-xl font-bold text-[#1A1A1A]">
                                        {product.data.price}€
                                    </span>
                                    <button class="p-3 bg-[#722F37] text-white rounded-xl hover:bg-[#8B2323] transition-colors">
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="20"
                                            height="20"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                        >
                                            <>
                                                <path d="M5 12h14" />
                                                <path d="M12 5v14" />
                                            </>
                                        </svg>
                                    </button>
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>

            {
                products.length === 0 && (
                    <div class="text-center py-20">
                        <p class="text-gray-500 italic">
                            Ez da produkturik aurkitu katalogoan.
                        </p>
                    </div>
                )
            }
        </div>
    </main>
    <Footer client:load />
</Layout>
