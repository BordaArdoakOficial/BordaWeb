---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import Footer from "../components/Footer";
import ProductExplorer from "../components/ProductExplorer";
import { getCollection } from "astro:content";

const products = await getCollection("products");
---

<Layout title="Produktuak | Borda Ardoak">
    <Navbar client:load pathname={Astro.url.pathname} />
    <main class="pt-24 pb-24 bg-[#FDFCFB] min-h-screen">
        <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8">
            <!-- Header Compacto -->
            <header class="mb-8 relative">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-gray-100 pb-8">
                    <div class="flex items-baseline gap-4">
                        <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-[#1A1A1A]">
                            Gure <span class="font-light italic font-serif">Produktuak</span>
                        </h1>
                        <p class="text-gray-400 text-sm font-medium hidden md:block">Borda Ardoak Hautaketa</p>
                    </div>
                </div>
            </header>

            <!-- Componente de Exploración Reactivo -->
            <ProductExplorer client:load initialProducts={products} />
        </div>
    </main>
    <Footer client:load />
</Layout>
    <Footer client:load />
</Layout>
