---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import Footer from "../components/Footer";
import { History, Store, Truck, CheckCircle2, UserCheck, Zap, Users } from "lucide-react";
---

<Layout title="Nor Gara">
    <Navbar client:load pathname={Astro.url.pathname} />
    <main class="pt-32">
        <!-- Hero Section -->
        <section class="py-24 bg-[#FDFCFB]">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="max-w-4xl">
                    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#722F37]/70 mb-4">Nor Gara</p>
                    <h1 class="text-5xl md:text-7xl font-bold tracking-tight text-[#1A1A1A] mb-10 leading-[1.1]">
                        Edari eta elikagaien saltzaile eta hornitzaileak gara.
                    </h1>
                    <div class="space-y-6 text-xl text-gray-600 leading-relaxed max-w-3xl">
                        <p>
                            Bigarren belaunaldian diarduen empresa familiar bat gara, eta egun, hiru anai-arreba eta lan talde profesional batek osatzen dugu Borda ardoak.
                        </p>
                        <p>
                            Gure produktuen zuzeneko salmentarako denda bat dugu Zarautzen (Foruen kalea N-12).
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Image Grid -->
        <section class="pb-32 px-4 sm:px-6 lg:px-8">
            <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-8">
                <div class="rounded-[3rem] overflow-hidden h-[500px] shadow-2xl relative group">
                    <img
                        src="/images/hero/vineyard.png"
                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                        alt="Vineyards"
                    />
                    <div class="absolute inset-0 bg-black/20 group-hover:bg-black/10 transition-colors"></div>
                </div>
                <div class="rounded-[3rem] overflow-hidden h-[500px] shadow-2xl relative group">
                    <img
                        src="/images/sections/store.png"
                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                        alt="Store Interior"
                    />
                    <div class="absolute inset-0 bg-black/20 group-hover:bg-black/10 transition-colors"></div>
                </div>
            </div>
        </section>

        <!-- Specific Details -->
        <section class="py-24 bg-white border-y border-gray-100">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
                    <div class="space-y-8">
                        <div class="inline-flex items-center space-x-2 px-4 py-2 bg-[#722F37]/5 rounded-full text-[#722F37] text-sm font-medium">
                            <CheckCircle2 size={16} />
                            <span>Aholkularitza Pertsonalizatua</span>
                        </div>
                        <h2 class="text-4xl font-bold text-[#1A1A1A]">Zerbitzu hurbila eta profesionala</h2>
                        <div class="space-y-6 text-lg text-gray-600">
                            <p>
                                Komertzialak ditugu osteleritza, elkarte gastronomiko, empresa… aholkularitza eta salmenta pertsonalizatuak eskaintzeko.
                            </p>
                            <p>
                                Banaketa zerbitzurako ibilgailu propioak ditugu, gure instalazioetatik zuzenean bezeroarengana iristeko ahalik eta modu egokienean.
                            </p>
                        </div>
                    </div>
                    <div class="bg-[#FDFCFB] p-12 rounded-[2.5rem] border border-gray-100 shadow-sm relative overflow-hidden">
                        <div class="absolute top-0 right-0 w-32 h-32 bg-[#722F37]/5 rounded-bl-[5rem]"></div>
                        <h3 class="text-2xl font-bold mb-8 text-[#1A1A1A]">Gure Bezeroak</h3>
                        <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            {[
                                "Tabernak",
                                "Jatetxeak",
                                "Elkarte gastronomikoak",
                                "Hotelak",
                                "Enpresak",
                                "Partikularrak eta abar luze bat...",
                            ].map((client) => (
                                <li class="flex items-center space-x-3 text-gray-700">
                                    <div class="w-1.5 h-1.5 rounded-full bg-[#722F37]"></div>
                                    <span>{client}</span>
                                </li>
                            ))}
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <!-- Zerbitzuak -->
        <section class="py-32 bg-[#FDFCFB]">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center mb-20">
                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#722F37]/70 mb-4">Zerbitzuak</p>
                <h2 class="text-4xl md:text-5xl font-bold text-[#1A1A1A]">Zuretzat eskaintzen duguna</h2>
            </div>
            
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    <!-- Detalle 1 -->
                    <div class="p-10 bg-white rounded-3xl shadow-sm border border-gray-100 hover:shadow-xl transition-all hover:-translate-y-1">
                        <div class="w-14 h-14 bg-[#722F37]/10 rounded-2xl flex items-center justify-center mb-8">
                            <Store className="text-[#722F37] w-7 h-7" />
                        </div>
                        <h3 class="text-xl font-bold mb-4 text-[#1A1A1A]">Produktu aukera zabala</h3>
                        <p class="text-gray-600 leading-relaxed">
                            Bertako nahiz kanpoko produktuak, betiko edo moda-modako produktuak jartzen ditugu zure eskura ahalik eta prezio-kalitate egokienean.
                        </p>
                    </div>

                    <!-- Detalle 2 -->
                    <div class="p-10 bg-white rounded-3xl shadow-sm border border-gray-100 hover:shadow-xl transition-all hover:-translate-y-1">
                        <div class="w-14 h-14 bg-[#722F37]/10 rounded-2xl flex items-center justify-center mb-8">
                            <UserCheck className="text-[#722F37] w-7 h-7" />
                        </div>
                        <h3 class="text-xl font-bold mb-4 text-[#1A1A1A]">Aholkularitza pertsonalizatua</h3>
                        <p class="text-gray-600 leading-relaxed">
                            Bezeroari entzun ostean, bere nahiak asetzen saiatzen gara. Gure esperientzia zabala eta upategietako profesionaletan oinarritzen gara.
                        </p>
                    </div>

                    <!-- Detalle 3 -->
                    <div class="p-10 bg-white rounded-3xl shadow-sm border border-gray-100 hover:shadow-xl transition-all hover:-translate-y-1">
                        <div class="w-14 h-14 bg-[#722F37]/10 rounded-2xl flex items-center justify-center mb-8">
                            <Zap className="text-[#722F37] w-7 h-7" />
                        </div>
                        <h3 class="text-xl font-bold mb-4 text-[#1A1A1A]">Zerbitzu azkarra</h3>
                        <p class="text-gray-600 leading-relaxed">
                            Gure almazenetik zuzenean zure etxeraino eramango dizugu, modu azkar eta eraginkorrean.
                        </p>
                    </div>

                    <!-- Detalle 4 -->
                    <div class="p-10 bg-white rounded-3xl shadow-sm border border-gray-100 hover:shadow-xl transition-all hover:-translate-y-1">
                        <div class="w-14 h-14 bg-[#722F37]/10 rounded-2xl flex items-center justify-center mb-8">
                            <Store className="text-[#722F37] w-7 h-7" />
                        </div>
                        <h3 class="text-xl font-bold mb-4 text-[#1A1A1A]">Denda fisikoko zerbitzua</h3>
                        <p class="text-gray-600 leading-relaxed">
                            Denda fisikoa Zarautzen, astelehenetik larunbatera irekita zure beharrizan guztietarako.
                        </p>
                    </div>

                    <!-- Detalle 5 -->
                    <div class="lg:col-span-2 p-10 bg-[#722F37] rounded-3xl shadow-lg border border-[#722F37] text-white">
                        <div class="w-14 h-14 bg-white/20 rounded-2xl flex items-center justify-center mb-8">
                            <CheckCircle2 className="text-white w-7 h-7" />
                        </div>
                        <h3 class="text-xl font-bold mb-4">Saldu osteko zerbitzua</h3>
                        <p class="text-white/80 leading-relaxed text-lg">
                            Salmentaren ondoren zure nahiak ez badira asetu produktua aldatzen dugu edo bestela dirua itzuli. Guretzat garrantzitsuena zure satisfacción da.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Quotes -->
        <section class="py-32 bg-white">
            <div class="max-w-4xl mx-auto px-4 text-center">
                <h2 class="text-4xl font-bold mb-12 leading-tight">
                    "Guretzat ardoa ez da edari bat bakarrik, gure bizimodua eta historia da."
                </h2>
                <p class="text-lg text-gray-500 italic pb-8">— Borda Familia</p>
            </div>
        </section>

    </main>
    <Footer client:load />
</Layout>
